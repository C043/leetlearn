# Local development (npm run dev) against the docker-compose Postgres
DATABASE_URL="postgresql://leetlearn:leetlearn_pass@localhost:5432/leetlearn_db?schema=public"

# Optional: Web Push (streak reminders). Keys are auto-generated and stored in
# the DB when unset. Subject must be a mailto: or https: URL (Apple rejects localhost).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT="mailto:you@example.com"
